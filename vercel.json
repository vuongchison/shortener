{
    "version": 2,
    "builds": [
        {
            "src": "app.py",
            "use": "@vercel/python"
        },
        {
            "src": "public/**",
            "use": "@vercel/static"
        }
    ],
    "routes": [
        {
            "src": "/api/(.*)",
            "dest": "app.py"
        },
        {
            "src": "/r/(.*)",
            "dest": "app.py"
        },
        {
            "src": "/(.*)",
            "methods": [
                "GET"
            ],
            "dest": "public/index.html"
        }
    ]
}